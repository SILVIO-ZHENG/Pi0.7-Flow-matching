{
  "ros_domain_id": "0",
  "state_topic": "/robot/state43",
  "action_topic": "/control/action_target43",
  "head_image_topic": "/camera/head/image_raw/compressed",
  "left_wrist_image_topic": "/camera/left_wrist/image_raw/compressed",
  "right_wrist_image_topic": "/camera/right_wrist/image_raw/compressed",
  "remote_host": "127.0.0.1",
  "remote_port": 8000,
  "prompt": "Use both hands to pick up the box and place it in the target area.",
  "plan_subtask": true,
  "controller_mode": "rtc",
  "control_hz": 20.0,
  "policy_action_hz": 20.0,
  "open_loop_horizon": 8,
  "max_action_chunk_len": 50,
  "interpolation": "linear",
  "request_when_remaining_steps": 10,
  "request_immediately_after_chunk": true,
  "rtc_min_horizon": 2,
  "rtc_delay_buffer_size": 16,
  "rtc_initial_delay_steps": 2,
  "max_state_age_ms": 100.0,
  "max_image_age_ms": 150.0,
  "joint_limits_path": "examples/unitree_g1/configs/g1_joint_limits.example.json",
  "enable_robot_commands": false,
  "episode_id": "inference",
  "log_dir": "./outputs/g1_policy_logs",
  "save_action_chunks": true
}
